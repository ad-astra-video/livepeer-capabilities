# S3-compatible object storage for secure wallet delivery
# Examples:
#   Vultr Object Storage: https://ewr1.vultrobjects.com
#   AWS S3:               https://s3.us-east-1.amazonaws.com
#   MinIO:                http://localhost:9000
S3_ENDPOINT=https://your-region.vultrobjects.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=livepeer-wallets
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=600
