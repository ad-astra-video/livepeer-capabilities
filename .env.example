# ─────────────────────────────────────────────────────────────
# REQUIRED: Production settings
# ─────────────────────────────────────────────────────────────

# Public URL workers use to reach the backend API.
# MUST be reachable from the internet (Vultr instances call back to this).
# Examples:
#   With domain:  https://monitor.example.com
#   With IP:      http://203.0.113.4:8088
# For local-only testing you can use http://localhost:8088
MAIN_SERVER_URL=http://localhost:8088

# Arbitrum RPC endpoint for go-livepeer gateways
ARB_ETH_URL=https://arb1.arbitrum.io/rpc

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
JWT_SECRET=your-jwt-secret

# Shared secret between backend and worker agents
WORKER_API_TOKEN=your-worker-token

# Vultr API key for spawning/destroying instances
VULTR_API_KEY=your-vultr-api-key

# S3-compatible object storage for secure wallet delivery
# Examples:
#   Vultr Object Storage: https://ewr1.vultrobjects.com
#   AWS S3:               https://s3.us-east-1.amazonaws.com
#   MinIO:                http://localhost:9000
S3_ENDPOINT=https://your-region.vultrobjects.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=livepeer-wallets
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=600


# ─────────────────────────────────────────────────────────────
# OPTIONAL: Local development only
# These are only needed when running `docker compose` inside worker/
# or testing the stack locally. They are NOT used by cloud-init/Vultr workers.
# ─────────────────────────────────────────────────────────────

# # Host for local Caddy (currently unused — Caddyfile hardcodes :8088)
# HOST=localhost

# # Worker identity for local agent testing
# WORKER_REGION=local
# VULTR_INSTANCE_ID=local-test-01

# # Keystore password for local go-livepeer gateways (worker/docker-compose.yml)
# ETH_PASSWORD=your-livepeer-wallet-password

